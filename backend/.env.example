# ── Base de données PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/yaaybooy

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
JWT_SECRET=changeme-replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Une seule origine :
CORS_ORIGINS=http://localhost:5173
# Plusieurs origines (format JSON) :
# CORS_ORIGINS=["http://localhost:5173","https://monapp.vercel.app"]

# ── Groq (chatbot IA — tier gratuit) ─────────────────────────────────────────
# Obtenir sur https://console.groq.com/keys (pas de CB requise)
# Laisser vide pour désactiver le chatbot sans erreur au démarrage
GROQ_API_KEY=
# Modèle recommandé (rapide + gratuit)
GROQ_MODEL=llama-3.3-70b-versatile
